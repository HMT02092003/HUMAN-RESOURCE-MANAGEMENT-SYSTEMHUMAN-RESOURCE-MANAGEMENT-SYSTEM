{
  "name": "hrms-application-service",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch . --ext js,ts,json --exec tsx server.js",
    "start": "tsx server.js",
    "worker": "node src/workers/cv-analysis-worker.js",
    "dev:all": "concurrently \"yarn dev\" \"yarn worker\"",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "cookie-parser": "^1.4.7",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^4.21.1",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "objection": "^3.1.5",
    "pg": "^8.13.1",
    "sharp": "^0.34.4",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.7"
  }
}