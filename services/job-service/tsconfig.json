{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "routes/**/*.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "knexfile.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "uploads"
  ]
}
