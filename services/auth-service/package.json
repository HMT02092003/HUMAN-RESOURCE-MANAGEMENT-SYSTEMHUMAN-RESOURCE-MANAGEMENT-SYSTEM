{
  "name": "hrms-auth-service",
  "version": "2.0.0",
  "description": "Optimized Authentication Service for HRMS",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch . --ext js,ts,json --exec tsx server.js",
    "start": "tsx server.js",
    "migrate": "knex migrate:latest",
    "seed": "knex seed:run",
    "rollback": "knex migrate:rollback",
    "health": "curl http://localhost:4001/health",
    "clean": "rm -rf node_modules yarn.lock",
    "reinstall": "yarn clean && yarn install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "objection": "^3.1.5",
    "pg": "^8.13.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": ["auth", "microservice", "hrms", "jwt", "authentication"],
  "author": "HRMS Team",
  "license": "MIT"
}
