# API Gateway Configuration
PORT=4000
NODE_ENV=development

# Service URLs (Docker service names for container networking)
# When running with Docker Compose, services communicate via service names
# Format: http://SERVICE-NAME:PORT
AUTH_SERVICE_URL=http://auth-service:4001
EMPLOYEE_SERVICE_URL=http://employee-service:4002
ATTENDANCE_SERVICE_URL=http://attendance-service:4003
AI_FACE_RECOGNITION_SERVICE_URL=http://ai-face-recognition-service:4106
SALARY_SERVICE_URL=http://salary-service:4007
JOB_SERVICE_URL=http://job-service:4008
APPLICATION_SERVICE_URL=http://application-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4009

# JWT Configuration
JWT_SECRET=c7c5f8d1a7b84e6a6c8b0f95c4b3e9a0f57e9d4a3c8a4b3d7e1f9b2c5d6e4f1
JWT_REFRESH_SECRET=c7c5f8d1a7b84e6a6c8b0f95c4b3e9a0f57e9d4a3c8a4b3d7e1f9b2c5d6e4f1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration (Gateway already sets origin: true)
ALLOWED_ORIGINS=