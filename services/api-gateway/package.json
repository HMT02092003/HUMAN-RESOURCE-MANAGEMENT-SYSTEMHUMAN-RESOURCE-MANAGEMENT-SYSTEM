{
  "name": "hrms-api-gateway",
  "version": "2.0.0",
  "description": "Optimized API Gateway for HRMS Microservices",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "health": "curl http://localhost:4000/gateway-health",
    "clean": "rm -rf node_modules yarn.lock",
    "reinstall": "yarn clean && yarn install"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "keywords": [
    "api-gateway",
    "microservices",
    "hrms",
    "proxy"
