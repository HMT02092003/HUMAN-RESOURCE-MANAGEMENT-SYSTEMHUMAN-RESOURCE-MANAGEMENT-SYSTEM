# Notification Service Configuration
PORT=4005
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hrms_notification
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_notification
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration (for token verification)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@hrms.com
EMAIL_REPLY_TO=support@hrms.com

# Push Notification Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# SMS Configuration (if using SMS service)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Notification Settings
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000
NOTIFICATION_EXPIRY_DAYS=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info

# API Gateway URL
API_GATEWAY_URL=http://localhost:3000 