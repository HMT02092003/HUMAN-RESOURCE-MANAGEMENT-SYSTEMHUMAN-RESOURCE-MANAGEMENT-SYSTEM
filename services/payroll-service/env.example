# Payroll Service Configuration
PORT=4004
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hrms_payroll
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_payroll
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration (for token verification)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Payroll Configuration
DEFAULT_CURRENCY=VND
MINIMUM_WAGE=1490000
SOCIAL_INSURANCE_RATE=0.08
HEALTH_INSURANCE_RATE=0.015
UNEMPLOYMENT_INSURANCE_RATE=0.01
PERSONAL_INCOME_TAX_THRESHOLD=11000000

# Overtime Rates
OVERTIME_RATE_150=1.5
OVERTIME_RATE_200=2.0
OVERTIME_RATE_300=3.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info

# API Gateway URL
API_GATEWAY_URL=http://localhost:3000

# Report Configuration
REPORT_EXPORT_PATH=./reports
REPORT_RETENTION_DAYS=365 