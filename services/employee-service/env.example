# Employee Service Configuration
PORT=4002
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hrms_employee
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_employee
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration (for token verification)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# File Upload Configuration
UPLOAD_PATH=./public/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info

# API Gateway URL (for service-to-service communication)
API_GATEWAY_URL=http://localhost:3000 