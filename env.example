# HRMS Microservices - Root Environment Configuration
# Copy this file to .env and update the values according to your setup

# ===================================
# DATABASE CONFIGURATION
# ===================================
# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password

# Database Names for each service
AUTH_DB_NAME=hrms_auth
EMPLOYEE_DB_NAME=hrms_employee
ATTENDANCE_DB_NAME=hrms_attendance
PAYROLL_DB_NAME=hrms_payroll
NOTIFICATION_DB_NAME=hrms_notification

# ===================================
# SERVICE PORTS
# ===================================
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=4001
EMPLOYEE_SERVICE_PORT=4002
ATTENDANCE_SERVICE_PORT=4003
PAYROLL_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005
FRONTEND_PORT=3001

# ===================================
# JWT CONFIGURATION
# ===================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===================================
# EMAIL CONFIGURATION
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@hrms.com

# ===================================
# CORS CONFIGURATION
# ===================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ===================================
# SECURITY CONFIGURATION
# ===================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# LOGGING CONFIGURATION
# ===================================
LOG_LEVEL=info
NODE_ENV=development

# ===================================
# FILE UPLOAD CONFIGURATION
# ===================================
UPLOAD_PATH=./public/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ===================================
# PAGINATION CONFIGURATION
# ===================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ===================================
# ATTENDANCE CONFIGURATION
# ===================================
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
WORKING_HOURS_START=08:00
WORKING_HOURS_END=17:00
LUNCH_BREAK_START=12:00
LUNCH_BREAK_END=13:00
LATE_THRESHOLD_MINUTES=15
EARLY_LEAVE_THRESHOLD_MINUTES=30
OVERTIME_THRESHOLD_MINUTES=60

# ===================================
# PAYROLL CONFIGURATION
# ===================================
DEFAULT_CURRENCY=VND
MINIMUM_WAGE=1490000
SOCIAL_INSURANCE_RATE=0.08
HEALTH_INSURANCE_RATE=0.015
UNEMPLOYMENT_INSURANCE_RATE=0.01
PERSONAL_INCOME_TAX_THRESHOLD=11000000
OVERTIME_RATE_150=1.5
OVERTIME_RATE_200=2.0
OVERTIME_RATE_300=3.0

# ===================================
# NOTIFICATION CONFIGURATION
# ===================================
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000
NOTIFICATION_EXPIRY_DAYS=30

# ===================================
# EXTERNAL SERVICES (Optional)
# ===================================
# Firebase (for push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Twilio (for SMS)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Analytics
GOOGLE_ANALYTICS_ID=your-ga-id
SENTRY_DSN=your-sentry-dsn 


# Cài toàn bộ node_modules
yarn install

# Migrate toàn bộ database
yarn migrate:all

# Seed toàn bộ database  
yarn seed:all

# Chạy toàn bộ service và frontend
yarn dev:all

cd services/api-gateway