import React, { useState, useMemo } from 'react';
import { Space, Typography, Tag, Tooltip, Badge, Select, DatePicker, Card, Row, Col, Statistic, Drawer, Tabs, Table, Avatar } from 'antd';
import { EyeOutlined, TrophyOutlined, ClockCircleOutlined, CheckCircleOutlined, WarningOutlined } from '@ant-design/icons';
import { ServerSideTable } from '@/components/common/ServerSideTable';
import type { ServerSideColumnType } from '@/components/common/ServerSideTable/types';
import jobService from '@/service/jobService';
import dayjs from 'dayjs';

const { Title, Text } = Typography;
const { Option } = Select;

interface KpiManagementListProps {}

const KpiManagementList: React.FC<KpiManagementListProps> = () => {
    const [selectedProject, setSelectedProject] = useState<string | null>(null);
    const [selectedMonth, setSelectedMonth] = useState<number>(dayjs().month() + 1);
    const [selectedYear, setSelectedYear] = useState<number>(dayjs().year());
    const [refreshTrigger, setRefreshTrigger] = useState(0);
    const [projectSummary, setProjectSummary] = useState<any>(null);
    
    // Detail drawer state
    const [detailDrawerVisible, setDetailDrawerVisible] = useState(false);
    const [selectedMember, setSelectedMember] = useState<any>(null);

    // Projects list for dropdown (you should fetch this from API)
    const [projectsList, setProjectsList] = useState<any[]>([]);

    // Fetch projects on mount
    React.useEffect(() => {
        const fetchProjects = async () => {
            try {
                const response = await jobService.getAllProjectByScope();
                const projects = response?.data?.results || [];
                setProjectsList(projects);
                if (projects.length > 0 && !selectedProject) {
                    setSelectedProject(String(projects[0].project_id));
                }
            } catch (error) {
                console.error('Error fetching projects:', error);
            }
        };
        fetchProjects();
    }, []);

    // Fetch function for ServerSideTable
    const fetchKpiData = async (params: any) => {
        if (!selectedProject) {
            return {
                data: [],
                total: 0,
                page: 1,
                pageSize: 10
            };
        }

        try {
            const response = await jobService.getProjectKpiReport(selectedProject, {
                month: selectedMonth,
                year: selectedYear,
                page: params.current,
                pageSize: params.pageSize,
                sortField: params.sortField,
                sortOrder: params.sortOrder,
                search: params.search
            });

            // Store project summary
            if (response.data?.project_summary) {
                setProjectSummary(response.data.project_summary);
            }

            return {
                data: response.data?.members || [],
                total: response.data?.pagination?.total || 0,
                page: response.data?.pagination?.page || 1,
                pageSize: response.data?.pagination?.pageSize || 10
            };
        } catch (error) {
            console.error('Error fetching KPI data:', error);
            return {
                data: [],
                total: 0,
                page: 1,
                pageSize: 10
            };
        }
    };

    const handleViewDetail = (record: any) => {
        setSelectedMember(record);
        setDetailDrawerVisible(true);
    };

    // Table columns
    const columns: ServerSideColumnType<any>[] = [
        {
            title: 'Nhân viên',
            dataIndex: 'name',
            key: 'name',
            width: 250,
            sorter: true,
            searchable: true,
            render: (text: string, record: any) => (
                <Space>
                    <Avatar src={record.avatar} size={40}>
                        {text?.charAt(0)?.toUpperCase() || 'U'}
                    </Avatar>
                    <div>
                        <div style={{ fontWeight: 500 }}>{text}</div>
                        <Text type="secondary" style={{ fontSize: 12 }}>
                            {record.email}
                        </Text>
                    </div>
                </Space>
            ),
        },
        {
            title: 'Vai trò',
            dataIndex: 'role',
            key: 'role',
            width: 150,
            render: (role: string) => (
                <Tag color="blue">{role || 'Member'}</Tag>
            ),
        },
        {
            title: 'KPI Score',
            dataIndex: ['stats', 'kpi_score'],
            key: 'kpi_score',
            width: 150,
            sorter: true,
            align: 'center',
            render: (score: number, record: any) => (
                <Space direction="vertical" size={0} style={{ width: '100%', alignItems: 'center' }}>
                    <Badge
                        count={record.badge}
                        style={{
                            backgroundColor:
                                record.badge_color === 'green' ? '#52c41a' :
                                record.badge_color === 'blue' ? '#1890ff' :
                                record.badge_color === 'yellow' ? '#faad14' :
                                '#ff4d4f',
                            fontSize: 12,
                            fontWeight: 'bold',
                            minWidth: 28,
                            height: 28,
                            lineHeight: '28px'
                        }}
                    />
                    <Text strong style={{ fontSize: 16, marginTop: 4 }}>
                        {score}%
                    </Text>
                </Space>
            ),
        },
        {
            title: 'Task hoàn thành',
            dataIndex: ['stats', 'total_done'],
            key: 'total_done',
            width: 150,
            sorter: true,
            align: 'center',
            render: (done: number, record: any) => (
                <div>
                    <Text strong style={{ fontSize: 16 }}>
                        {done}/{record.stats.total_assigned}
                    </Text>
                </div>
            ),
        },
        {
            title: 'Chi tiết tiến độ',
            key: 'progress_detail',
            width: 250,
            render: (_: any, record: any) => {
                const { count_early, count_on_time, count_late, overdue } = record.stats;
                return (
                    <Space direction="vertical" size={2}>
                        {count_early > 0 && (
                            <Text style={{ color: '#52c41a' }}>
                                ● {count_early} Sớm
                            </Text>
                        )}
                        {count_on_time > 0 && (
                            <Text style={{ color: '#1890ff' }}>
                                ● {count_on_time} Đúng hạn
                            </Text>
                        )}
                        {count_late > 0 && (
                            <Tooltip
                                title={
                                    <div>
                                        {record.late_tasks?.slice(0, 3).map((task: any) => (
                                            <div key={task.task_id}>
                                                {task.title} - Trễ {task.delay_days} ngày
                                            </div>
                                        ))}
                                        {record.late_tasks?.length > 3 && (
                                            <div>... và {record.late_tasks.length - 3} task khác</div>
                                        )}
                                    </div>
                                }
                            >
                                <Text style={{ color: '#ff4d4f', cursor: 'pointer' }}>
                                    ● {count_late} Muộn
                                </Text>
                            </Tooltip>
                        )}
                        {overdue > 0 && (
                            <Text style={{ color: '#ff7a45' }}>
                                ⚠ {overdue} Quá hạn
                            </Text>
                        )}
                    </Space>
                );
            },
        },
        {
            title: 'Trung bình trễ',
            dataIndex: ['stats', 'avg_delay_hours'],
            key: 'avg_delay_hours',
            width: 120,
            sorter: true,
            align: 'center',
            render: (hours: number) => (
                <Text>{hours > 0 ? `${hours}h` : '-'}</Text>
            ),
        },
        {
            title: 'Hành động',
            key: 'action',
            width: 120,
            align: 'center',
            render: (_: any, record: any) => (
                <Space>
                    <Tooltip title="Xem chi tiết">
                        <EyeOutlined
                            style={{ fontSize: 18, color: '#1890ff', cursor: 'pointer' }}
                            onClick={() => handleViewDetail(record)}
                        />
                    </Tooltip>
                </Space>
            ),
        },
    ];

    return (
        <div>
            {/* Filters Section */}
            <Card style={{ marginBottom: 16 }}>
                <Row gutter={16} align="middle">
                    <Col span={8}>
                        <div style={{ marginBottom: 8 }}>
                            <Text strong>Chọn dự án:</Text>
                        </div>
                        <Select
                            style={{ width: '100%' }}
                            placeholder="Chọn dự án"
                            value={selectedProject}
                            onChange={(value) => {
                                setSelectedProject(value);
                                setRefreshTrigger(prev => prev + 1);
                            }}
                        >
                            {projectsList.map(project => (
                                <Option key={project.project_id} value={String(project.project_id)}>
                                    {project.name}
                                </Option>
                            ))}
                        </Select>
                    </Col>
                    <Col span={4}>
                        <div style={{ marginBottom: 8 }}>
                            <Text strong>Tháng:</Text>
                        </div>
                        <Select
                            style={{ width: '100%' }}
                            value={selectedMonth}
                            onChange={(value) => {
                                setSelectedMonth(value);
                                setRefreshTrigger(prev => prev + 1);
                            }}
                        >
                            {Array.from({ length: 12 }, (_, i) => i + 1).map(month => (
                                <Option key={month} value={month}>
                                    Tháng {month}
                                </Option>
                            ))}
                        </Select>
                    </Col>
                    <Col span={4}>
                        <div style={{ marginBottom: 8 }}>
                            <Text strong>Năm:</Text>
                        </div>
                        <Select
                            style={{ width: '100%' }}
                            value={selectedYear}
                            onChange={(value) => {
                                setSelectedYear(value);
                                setRefreshTrigger(prev => prev + 1);
                            }}
                        >
                            {[2023, 2024, 2025, 2026].map(year => (
                                <Option key={year} value={year}>
                                    {year}
                                </Option>
                            ))}
                        </Select>
                    </Col>
                </Row>
            </Card>

            {/* Summary Cards */}
            {projectSummary && (
                <Card style={{ marginBottom: 16 }}>
                    <Row gutter={16}>
                        <Col span={6}>
                            <Statistic
                                title="Tổng task"
                                value={projectSummary.total_tasks}
                                prefix={<TrophyOutlined />}
                            />
                        </Col>
                        <Col span={6}>
                            <Statistic
                                title="Task hoàn thành"
                                value={projectSummary.total_done}
                                prefix={<CheckCircleOutlined />}
                                valueStyle={{ color: '#52c41a' }}
                            />
                        </Col>
                        <Col span={6}>
                            <Statistic
                                title="KPI trung bình"
                                value={projectSummary.avg_kpi}
                                suffix="%"
                                prefix={<TrophyOutlined />}
                                valueStyle={{
                                    color: projectSummary.avg_kpi >= 85 ? '#52c41a' : '#ff4d4f'
                                }}
                            />
                        </Col>
                        <Col span={6}>
                            <Statistic
                                title="Tổng thành viên"
                                value={projectSummary.total_members}
                                prefix={<WarningOutlined />}
                            />
                        </Col>
                    </Row>
                </Card>
            )}

            {/* Main Table */}
            <ServerSideTable
                columns={columns}
                fetchData={fetchKpiData}
                refreshTrigger={refreshTrigger}
                rowKey="user_id"
                scroll={{ x: 1400 }}
            />

            {/* Detail Drawer */}
            <Drawer
                title={`Chi tiết KPI - ${selectedMember?.name || ''}`}
                placement="right"
                width={720}
                open={detailDrawerVisible}
                onClose={() => setDetailDrawerVisible(false)}
            >
                {selectedMember && (
                    <div>
                        <Card style={{ marginBottom: 16 }}>
                            <Space direction="vertical" size={16} style={{ width: '100%' }}>
                                <Space>
                                    <Avatar src={selectedMember.avatar} size={64}>
                                        {selectedMember.name?.charAt(0)?.toUpperCase()}
                                    </Avatar>
                                    <div>
                                        <Title level={4} style={{ margin: 0 }}>
                                            {selectedMember.name}
                                        </Title>
                                        <Text type="secondary">{selectedMember.email}</Text>
                                        <br />
                                        <Tag color="blue">{selectedMember.role}</Tag>
                                        <Badge
                                            count={selectedMember.badge}
                                            style={{
                                                backgroundColor:
                                                    selectedMember.badge_color === 'green' ? '#52c41a' :
                                                    selectedMember.badge_color === 'blue' ? '#1890ff' :
                                                    selectedMember.badge_color === 'yellow' ? '#faad14' :
                                                    '#ff4d4f',
                                                marginLeft: 8
                                            }}
                                        />
                                    </div>
                                </Space>
                                <Row gutter={16}>
                                    <Col span={12}>
                                        <Statistic
                                            title="KPI Score"
                                            value={selectedMember.stats?.kpi_score}
                                            suffix="%"
                                        />
                                    </Col>
                                    <Col span={12}>
                                        <Statistic
                                            title="Task hoàn thành"
                                            value={`${selectedMember.stats?.total_done}/${selectedMember.stats?.total_assigned}`}
                                        />
                                    </Col>
                                </Row>
                            </Space>
                        </Card>

                        <Tabs
                            defaultActiveKey="late"
                            items={[
                                {
                                    key: 'late',
                                    label: `Task chậm tiến độ (${selectedMember.late_tasks?.length || 0})`,
                                    children: (
                                        <Table
                                            dataSource={selectedMember.late_tasks || []}
                                            rowKey="task_id"
                                            pagination={false}
                                            columns={[
                                                {
                                                    title: 'Task',
                                                    dataIndex: 'title',
                                                    key: 'title',
                                                },
                                                {
                                                    title: 'Hạn hoàn thành',
                                                    dataIndex: 'due_date',
                                                    key: 'due_date',
                                                    render: (date: string) => dayjs(date).format('DD/MM/YYYY'),
                                                },
                                                {
                                                    title: 'Hoàn thành lúc',
                                                    dataIndex: 'completed_at',
                                                    key: 'completed_at',
                                                    render: (date: string) => dayjs(date).format('DD/MM/YYYY HH:mm'),
                                                },
                                                {
                                                    title: 'Trễ',
                                                    key: 'delay',
                                                    render: (_: any, record: any) => (
                                                        <Text type="danger">
                                                            {record.delay_days} ngày ({record.delay_hours}h)
                                                        </Text>
                                                    ),
                                                },
                                            ]}
                                        />
                                    ),
                                },
                                {
                                    key: 'stats',
                                    label: 'Thống kê',
                                    children: (
                                        <Space direction="vertical" size={16} style={{ width: '100%' }}>
                                            <Card>
                                                <Statistic
                                                    title="Task sớm hạn"
                                                    value={selectedMember.stats?.count_early || 0}
                                                    valueStyle={{ color: '#52c41a' }}
                                                />
                                            </Card>
                                            <Card>
                                                <Statistic
                                                    title="Task đúng hạn"
                                                    value={selectedMember.stats?.count_on_time || 0}
                                                    valueStyle={{ color: '#1890ff' }}
                                                />
                                            </Card>
                                            <Card>
                                                <Statistic
                                                    title="Task chậm hạn"
                                                    value={selectedMember.stats?.count_late || 0}
                                                    valueStyle={{ color: '#ff4d4f' }}
                                                />
                                            </Card>
                                            <Card>
                                                <Statistic
                                                    title="Trung bình trễ"
                                                    value={selectedMember.stats?.avg_delay_hours || 0}
                                                    suffix="giờ"
                                                />
                                            </Card>
                                        </Space>
                                    ),
                                },
                            ]}
                        />
                    </div>
                )}
            </Drawer>
        </div>
    );
};

export default KpiManagementList;
