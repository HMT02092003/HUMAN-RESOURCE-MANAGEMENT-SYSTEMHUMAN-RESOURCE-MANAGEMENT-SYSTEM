{
    "name": "hrms-microservices",
    "version": "1.0.0",
    "description": "Human Resource Management System with Microservices",
    "private": true,
    "type": "module",
    "workspaces": {
        "packages": [
            "frontend",
            "services/api-gateway",
            "services/auth-service",
            "services/employee-service",
            "services/attendance-service",
            "services/payroll-service",
            "services/notification-service"
        ],
        "nohoist": [
            "**/react",
            "**/react-dom",
            "**/styled-jsx",
            "**/next"
        ]
    },
    "scripts": {
        "create:service": "node create-service.js",
        "setup:env": "bash setup-env.sh",
        "setup:env:windows": "setup-env.bat",
        "dev:gateway": "cd services/api-gateway && yarn dev",
        "dev:auth": "cd services/auth-service && yarn dev",
        "dev:employee": "cd services/employee-service && yarn dev",
        "dev:attendance": "cd services/attendance-service && yarn dev",
        "dev:payroll": "cd services/payroll-service && yarn dev",
        "dev:notification": "cd services/notification-service && yarn dev",
        "dev:frontend": "cd frontend && yarn dev",
        "dev": "concurrently \"yarn dev:gateway\" \"yarn dev:auth\" \"yarn dev:employee\" \"yarn dev:attendance\" \"yarn dev:payroll\" \"yarn dev:notification\" \"yarn dev:frontend\"",
        "dev:core": "concurrently \"yarn dev:gateway\" \"yarn dev:auth\" \"yarn dev:employee\" \"yarn dev:frontend\"",
        "install:all": "yarn install",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "start:gateway": "cd services/api-gateway && yarn start",
        "start:auth": "cd services/auth-service && yarn start",
        "start:employee": "cd services/employee-service && yarn start",
        "start:attendance": "cd services/attendance-service && yarn start",
        "start:payroll": "cd services/payroll-service && yarn start",
        "start:notification": "cd services/notification-service && yarn start",
        "start:frontend": "cd frontend && yarn start",
        "start:all": "concurrently \"yarn start:gateway\" \"yarn start:auth\" \"yarn start:employee\" \"yarn start:attendance\" \"yarn start:payroll\" \"yarn start:notification\" \"yarn start:frontend\"",
        "db:migrate": "cd services/auth-service && yarn migrate && cd ../employee-service && yarn migrate && cd ../attendance-service && yarn migrate && cd ../payroll-service && yarn migrate",
        "db:seed": "cd services/auth-service && yarn seed && cd ../employee-service && yarn seed && cd ../attendance-service && yarn seed && cd ../payroll-service && yarn seed",
        "migrate:all": "yarn workspaces run migrate",
        "seed:all": "yarn workspaces run seed",
        "dev:all": "yarn workspaces run dev",
        "setup": "yarn setup:env && yarn install && yarn migrate:all && yarn seed:all"
    },
    "dependencies": {
        "@ant-design/icons": "^5.5.2",
        "@ant-design/plots": "^2.3.3",
        "@types/multer": "^1.4.12",
        "antd": "^5.22.1",
        "antd-style": "^3.7.1",
        "await-to-js": "^3.0.0",
        "axios": "^1.7.7",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^2.4.3",
        "chart.js": "^4.4.7",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-fileupload": "^1.5.1",
        "js-cookie": "^3.0.5",
        "jsonwebtoken": "^9.0.2",
        "knex": "^3.1.0",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.0",
        "multer": "^1.4.5-lts.1",
        "next": "^14.2.7",
        "nodemailer": "^6.9.16",
        "objection": "^3.1.5",
        "pg": "^8.17.2",
        "react": "^19.0.0",
        "react-chartjs-2": "^5.3.0",
        "react-dom": "^19.0.0",
        "react-highlight-words": "^0.21.0",
        "react-router-dom": "^7.1.1",
        "react-topbar-progress-indicator": "^4.1.1",
        "recharts": "^2.15.0",
        "sharp": "^0.34.5",
        "ts-node": "^10.9.2",
        "uuid": "^11.0.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/crypto-js": "^4.2.2",
        "@types/express": "^5.0.0",
        "@types/express-fileupload": "^1.5.1",
        "@types/js-cookie": "^3.0.6",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/lodash": "^4.17.13",
        "@types/node": "^22.9.1",
        "@types/nodemailer": "^6.4.17",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@types/react-highlight-words": "^0.20.0",
        "@types/uuid": "^10.0.0",
        "concurrently": "^8.2.0",
        "magic-snowflakes": "^7.0.1",
        "nodemon": "^3.1.7",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "main": "index.js",
    "author": "hoang.manh.toan <hoang.manh.toan@mqsolutions.com.vn>",
    "license": "MIT",
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
